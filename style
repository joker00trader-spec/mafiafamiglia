/* ===== style.css (suite) - MAFIA FAMIGLIA ===== */

/* ===== BOUTON MUSIQUE ===== */
.music-btn {
    background: transparent;
    border: 2px solid var(--or-vieilli);
    color: var(--jaune-pale);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.85rem;
    padding: 0;
}

.music-btn:hover {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
    transform: scale(1.1);
    box-shadow: 0 0 10px rgba(195, 154, 91, 0.5);
}

.music-btn.playing {
    color: var(--or-vieilli);
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(195, 154, 91, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(195, 154, 91, 0); }
    100% { box-shadow: 0 0 0 0 rgba(195, 154, 91, 0); }
}

/* ===== LANGUE ===== */
.lang-switch {
    display: flex;
    gap: 0.3rem;
}

.lang-btn {
    background: transparent;
    border: 2px solid var(--or-vieilli);
    border-radius: 40px;
    padding: 0.2rem 0.7rem;
    color: var(--blanc-pur);
    font-family: 'Cinzel', serif;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
}

.lang-btn img {
    width: 16px;
    height: 11px;
    border-radius: 2px;
    object-fit: cover;
}

.lang-btn.active {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
    border-color: var(--or-vieilli);
}

/* ===== MENU ===== */
.menu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.2rem;
}

.menu-item {
    background: rgba(26, 29, 30, 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid var(--or-vieilli);
    border-radius: 16px;
    padding: 0.6rem 0.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--jaune-pale);
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    transition: 0.2s;
    text-align: center;
}

.menu-item:hover {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
    border-color: var(--jaune-pale);
    transform: translateY(-2px);
}

.menu-item.active {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
    border-color: var(--jaune-pale);
}

/* ===== BANDE INFO ===== */
.info-band {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 0.8rem 1.5rem;
    background: rgba(26, 29, 30, 0.7);
    backdrop-filter: blur(8px);
    border: 2px solid var(--or-vieilli);
    border-radius: 50px;
    position: relative;
}

.info-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.5rem 1rem;
    border-radius: 40px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(195, 154, 91, 0.3);
    z-index: 2;
}

/* FIN DU ROUND */
.info-item.round {
    color: var(--jaune-pale);
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-size: 0.9rem;
}

.info-item.round i {
    color: var(--or-vieilli);
    font-size: 1.1rem;
}

.round-timer {
    font-family: monospace;
    font-size: 1rem;
    color: var(--jaune-pale);
    font-weight: 900;
    letter-spacing: 0.5px;
}

/* CADEAUX AVEC FLASH */
.info-item.cadeaux {
    background: linear-gradient(145deg, rgba(255, 215, 0, 0.2), rgba(178, 34, 34, 0.2));
    border: 2px solid var(--cadeau-or);
    animation: flashCadeauDoux 10s infinite;
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
}

@keyframes flashCadeauDoux {
    0% { border-color: var(--cadeau-or); box-shadow: 0 0 10px rgba(255, 215, 0, 0.3); }
    50% { border-color: var(--or-vieilli); box-shadow: 0 0 20px rgba(195, 154, 91, 0.4); }
    100% { border-color: var(--cadeau-or); box-shadow: 0 0 10px rgba(255, 215, 0, 0.3); }
}

.cadeau-icon {
    font-size: 1.3rem;
    animation: bounce 1s infinite;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
}

.cadeau-text {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.cadeau-titre {
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    color: var(--blanc-pur);
    text-transform: uppercase;
}

.cadeau-valeur {
    font-family: 'Cinzel', serif;
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--cadeau-or);
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
}

.cadeau-valeur span {
    font-size: 0.8rem;
    color: var(--cyan-brume);
    margin-left: 0.2rem;
}

/* BONUS DIAMONDS */
.info-item.bonus {
    color: var(--cyan-brume);
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-size: 0.9rem;
}

.bonus-timer {
    font-family: monospace;
    font-size: 1.2rem;
    color: var(--jaune-pale);
    font-weight: 900;
}

.bonus-timer i {
    color: var(--or-vieilli);
    margin-right: 0.5rem;
}

/* ===== GRILLE 2 COLONNES ===== */
.dashboard-grid {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 1.2rem;
    margin-bottom: 1.5rem;
}

/* ===== FICHE JOUEUR GAUCHE ===== */
.player-card {
    background: var(--gris-anthracite);
    backdrop-filter: blur(12px);
    border: 1px solid var(--or-vieilli);
    border-radius: 20px;
    padding: 1.2rem;
    position: sticky;
    top: 20px;
    height: fit-content;
}

.player-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--or-vieilli);
    padding-bottom: 0.8rem;
}

.player-avatar {
    width: 48px;
    height: 48px;
    background: var(--or-vieilli);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 900;
    border: 2px solid var(--blanc-pur);
}

.player-info h3 {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    color: var(--blanc-pur);
}

.player-info .famille {
    color: var(--jaune-pale);
    font-size: 0.7rem;
    font-weight: 600;
    margin-top: 0.15rem;
}

.player-info .role-palier {
    color: var(--cyan-brume);
    font-size: 0.65rem;
    margin-top: 0.1rem;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    background: var(--bleu-nuit);
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.25rem;
    border-left: 2px solid var(--or-vieilli);
    font-size: 0.75rem;
}

.stat-value {
    color: var(--jaune-pale);
    font-weight: 600;
}

.section-title {
    color: var(--or-vieilli);
    font-family: 'Cinzel';
    font-size: 0.85rem;
    margin: 0.8rem 0 0.4rem;
    border-bottom: 1px solid var(--or-vieilli);
    padding-bottom: 0.15rem;
}

.ressource-item {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0;
    font-size: 0.7rem;
    border-bottom: 1px solid var(--cyan-brume);
}

.ressource-item .value {
    color: var(--jaune-pale);
    font-weight: 600;
}

.ressource-item .label {
    color: var(--cyan-brume);
}

/* ===== ZONE DE RECRUTEMENT ===== */
.recruit-card {
    background: var(--gris-anthracite);
    backdrop-filter: blur(12px);
    border: 1px solid var(--or-vieilli);
    border-radius: 20px;
    padding: 1.2rem;
}

.recruit-title {
    font-family: 'Cinzel';
    font-size: 1.5rem;
    color: var(--jaune-pale);
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--or-vieilli);
    padding-bottom: 0.4rem;
}

/* ===== BONUS SÉPARÉS ===== */
.bonus-container {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
}

.bonus-item {
    flex: 1;
    min-width: 160px;
    background: var(--bleu-nuit);
    border: 1px solid var(--or-vieilli);
    border-radius: 16px;
    padding: 0.8rem;
    position: relative;
    overflow: hidden;
}

.bonus-item.paris::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/SNzf5NRg/Gemini-Generated-Image-k65o7ok65o7ok65o.png');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.bonus-item.famiglia::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/cJ1DVyV6/Ultra-realistic-cinematic-poster-of-1920s-mafia-city-street-at-night-vintage-gangster-atmosphere-d.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.bonus-item > * {
    position: relative;
    z-index: 1;
}

.bonus-title {
    font-family: 'Cinzel';
    font-size: 0.9rem;
    color: var(--jaune-pale);
    margin-bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.bonus-title i {
    color: var(--or-vieilli);
    font-size: 0.8rem;
}

.bonus-details {
    color: var(--cyan-brume);
    font-size: 0.75rem;
    line-height: 1.4;
}

.bonus-details span {
    color: var(--blanc-pur);
    font-weight: 600;
}

/* ===== RECRUTEMENT GROUPÉ ===== */
.bulk-recruit {
    margin-bottom: 1.5rem;
    background: var(--bleu-nuit);
    border: 2px solid var(--or-vieilli);
    border-radius: 16px;
    padding: 1rem;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.bulk-recruit::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/T2jDWLKs/Gemini-Generated-Image-c3vxmzc3vxmzc3vx.png');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.bulk-recruit > * {
    position: relative;
    z-index: 1;
}

.bulk-recruit-title {
    font-family: 'Cinzel';
    font-size: 1.1rem;
    color: var(--jaune-pale);
    margin-bottom: 0.6rem;
}

.bulk-recruit-btn {
    background: linear-gradient(145deg, var(--or-vieilli), #8B6B3C);
    border: 2px solid var(--jaune-pale);
    color: var(--gris-anthracite);
    font-family: 'Cinzel';
    font-weight: 900;
    font-size: 1.1rem;
    padding: 0.6rem 1.2rem;
    border-radius: 50px;
    cursor: pointer;
    transition: 0.3s;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    width: 100%;
    max-width: 350px;
    margin: 0 auto;
    display: block;
}

.bulk-recruit-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 0 15px rgba(195, 154, 91, 0.5);
    background: var(--jaune-pale);
}

.bulk-preview {
    margin-top: 0.6rem;
    color: var(--cyan-brume);
    font-size: 0.75rem;
}

.bulk-preview span {
    color: var(--jaune-pale);
    font-weight: 600;
}

/* ===== GRILLE DE RECRUTEMENT ===== */
.recruit-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
}

.recruit-category {
    background: transparent;
    border-radius: 16px;
    padding: 0;
}

.category-name {
    font-family: 'Cinzel';
    font-size: 1.1rem;
    color: var(--jaune-pale);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--or-vieilli);
    padding-bottom: 0.4rem;
    text-align: center;
}

/* ===== CADRES INDIVIDUELS ===== */
.recruit-card-item {
    background: var(--bleu-nuit);
    border: 2px solid var(--or-vieilli);
    border-radius: 16px;
    padding: 1rem;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.recruit-card-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 15px rgba(195, 154, 91, 0.2);
    border-color: var(--jaune-pale);
}

/* Images de fond pour chaque type */
.recruit-card-item.gardes::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/CM9jjT7d/Gemini-Generated-Image-t128zdt128zdt128.png');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.recruit-card-item.gangsters::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/TYGP8tYk/Gemini-Generated-Image-lpjbbylpjbbylpjb.png');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.recruit-card-item.tueurs::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/W15zw0V7/Gemini-Generated-Image-t5sn1ft5sn1ft5sn.png');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.recruit-card-item.braqueurs::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/BvDWnGmB/braqueures.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.recruit-card-item.tricheurs::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/rsg22CQP/tricheurs.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.recruit-card-item.faussaires::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/9Xb6MbY4/faussaires.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
}

.recruit-card-item > * {
    position: relative;
    z-index: 1;
}

.card-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid rgba(195, 154, 91, 0.3);
    padding-bottom: 0.6rem;
}

.card-title {
    font-family: 'Cinzel';
    font-size: 1.1rem;
    color: var(--blanc-pur);
}

.card-stats {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.6rem;
    color: var(--cyan-brume);
    font-size: 0.75rem;
}

.card-stats span {
    color: var(--jaune-pale);
    font-weight: 600;
}

.card-cost {
    background: var(--gris-anthracite);
    border-radius: 40px;
    padding: 0.3rem 0.8rem;
    text-align: center;
    margin-bottom: 0.8rem;
    font-size: 0.75rem;
    border: 1px solid var(--or-vieilli);
}

.card-cost .diamonds {
    color: var(--jaune-pale);
    font-weight: 600;
    font-size: 0.9rem;
}

.card-control {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
}

.quantity-control {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    flex: 1;
}

.quantity-btn {
    background: var(--gris-anthracite);
    border: 1px solid var(--or-vieilli);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
}

/* Couleurs différentes pour hommes et travailleurs */
.recruit-card-item.gardes .quantity-btn,
.recruit-card-item.gangsters .quantity-btn,
.recruit-card-item.tueurs .quantity-btn {
    color: var(--couleur-hommes);
}

.recruit-card-item.braqueurs .quantity-btn,
.recruit-card-item.tricheurs .quantity-btn,
.recruit-card-item.faussaires .quantity-btn {
    color: var(--couleur-travailleurs);
}

.quantity-btn:hover {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
}

.quantity-input {
    width: 60px;
    background: var(--gris-anthracite);
    border: 1px solid var(--or-vieilli);
    border-radius: 40px;
    padding: 0.4rem;
    color: white;
    text-align: center;
    font-size: 0.8rem;
}

.recruit-btn {
    border: 2px solid var(--jaune-pale);
    padding: 0.5rem 1rem;
    border-radius: 40px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    min-width: 90px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    transition: 0.2s;
}

/* Couleurs différentes pour les boutons */
.recruit-card-item.gardes .recruit-btn,
.recruit-card-item.gangsters .recruit-btn,
.recruit-card-item.tueurs .recruit-btn {
    background: var(--couleur-hommes);
    color: var(--gris-anthracite);
}

.recruit-card-item.braqueurs .recruit-btn,
.recruit-card-item.tricheurs .recruit-btn,
.recruit-card-item.faussaires .recruit-btn {
    background: var(--couleur-travailleurs);
    color: white;
}

.recruit-btn:hover {
    background: var(--jaune-pale);
    transform: scale(1.03);
}

.recruit-btn:disabled {
    background: var(--cyan-brume);
    border-color: var(--cyan-brume);
    cursor: not-allowed;
    opacity: 0.5;
}

.error-message {
    color: var(--erreur-rouge);
    font-size: 0.65rem;
    margin-top: 0.4rem;
    display: none;
}

/* ===== BARRE SOCIALE ===== */
.social-bar {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    background: var(--gris-anthracite);
    backdrop-filter: blur(8px);
    border-radius: 40px;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--or-vieilli);
}

.social-links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
}

.social-link {
    background: transparent;
    border: 2px solid var(--or-vieilli);
    border-radius: 40px;
    padding: 0.3rem 0.8rem;
    color: var(--blanc-pur);
    text-decoration: none;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: 0.2s;
}

.social-link:hover {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
}

.social-link img {
    filter: invert(1);
    width: 16px;
    height: 16px;
}

.parrainage-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bleu-nuit);
    border-radius: 40px;
    padding: 0.25rem 0.8rem;
}

.parrainage-box span {
    color: var(--jaune-pale);
    font-weight: 600;
    font-size: 0.7rem;
}

.parrainage-btn {
    background: var(--rouge-sang);
    border: none;
    color: white;
    padding: 0.25rem 0.8rem;
    border-radius: 40px;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--or-vieilli);
}

.parrainage-btn:hover {
    background: #8b1a1a;
}

/* ===== POPUP ===== */
.action-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(21, 34, 38, 0.9);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
    font-family: 'Cinzel', serif;
}

.action-popup.show {
    opacity: 1;
    visibility: visible;
}

.popup-content {
    background: linear-gradient(145deg, #1a1a1a, #0a0a0a);
    border: 3px solid var(--or-vieilli);
    border-radius: 25px;
    padding: 1.5rem;
    max-width: 380px;
    width: 90%;
    position: relative;
    box-shadow: 0 0 40px rgba(195, 154, 91, 0.3);
    transform: scale(0.7);
    transition: transform 0.4s ease;
    overflow: hidden;
}

.popup-content::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.postimg.cc/yxv1VzvG/Ultra-realistic-cinematic-poster-of-1920s-mafia-city-street-at-night-vintage-gangster-atmosphere-d.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    z-index: 0;
    pointer-events: none;
}

.action-popup.show .popup-content {
    transform: scale(1);
}

.popup-content > * {
    position: relative;
    z-index: 2;
}

.popup-close-x {
    position: absolute;
    top: 12px;
    right: 15px;
    font-size: 1.5rem;
    color: var(--cyan-brume);
    cursor: pointer;
    transition: 0.3s;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bleu-nuit);
    border: 1px solid var(--or-vieilli);
    z-index: 10;
}

.popup-close-x:hover {
    color: var(--jaune-pale);
    transform: scale(1.1);
    border-color: var(--jaune-pale);
}

.popup-header {
    text-align: center;
    margin-bottom: 1.2rem;
}

.popup-header h3 {
    font-size: 1.5rem;
    color: var(--jaune-pale);
    text-transform: uppercase;
    letter-spacing: 2.5px;
    text-shadow: 0 0 8px rgba(195, 154, 91, 0.5);
}

.popup-header .subtitle {
    color: var(--cyan-brume);
    font-size: 0.7rem;
    margin-top: 0.25rem;
}

.popup-divider {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--or-vieilli), var(--rouge-sang), var(--or-vieilli), transparent);
    margin: 0.8rem 0;
}

.popup-icon {
    font-size: 2.5rem;
    text-align: center;
    margin: 0.4rem 0;
}

.popup-message {
    text-align: center;
    font-size: 0.9rem;
    margin: 0.8rem 0;
    color: var(--blanc-pur);
}

.popup-details {
    background: var(--bleu-nuit);
    border: 1px solid var(--or-vieilli);
    border-radius: 12px;
    padding: 0.8rem;
    margin: 0.8rem 0;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--cyan-brume);
}

.detail-row:last-child {
    border-bottom: none;
}

.detail-label {
    color: var(--cyan-brume);
    font-size: 0.75rem;
}

.detail-value {
    color: var(--jaune-pale);
    font-weight: 600;
    font-size: 0.75rem;
}

.popup-footer {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 0.8rem;
}

.popup-confirm, .popup-cancel {
    background: transparent;
    border: 2px solid var(--or-vieilli);
    color: var(--jaune-pale);
    font-family: 'Cinzel';
    font-size: 0.85rem;
    padding: 0.5rem 1.2rem;
    border-radius: 40px;
    cursor: pointer;
    transition: 0.3s;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    flex: 1;
}

.popup-confirm:hover {
    background: var(--or-vieilli);
    color: var(--gris-anthracite);
}

.popup-cancel {
    border-color: var(--rouge-sang);
    color: var(--rouge-sang);
}

.popup-cancel:hover {
    background: var(--rouge-sang);
    color: var(--gris-anthracite);
}

.popup-decoration {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    border: 1px solid rgba(195, 154, 91, 0.2);
    border-radius: 18px;
    pointer-events: none;
    z-index: 1;
}

.popup-decoration::before {
    content: "⚜️";
    position: absolute;
    top: -12px;
    left: -12px;
    font-size: 1.6rem;
    transform: rotate(-15deg);
    opacity: 0.3;
}

.popup-decoration::after {
    content: "⚜️";
    position: absolute;
    bottom: -12px;
    right: -12px;
    font-size: 1.6rem;
    transform: rotate(15deg);
    opacity: 0.3;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
    .player-card {
        position: static;
    }
    .recruit-columns {
        grid-template-columns: 1fr;
    }
    .bonus-container {
        flex-direction: column;
    }
    .info-band {
        grid-template-columns: 1fr;
        gap: 0.5rem;
    }
    .top-bar {
        flex-direction: column;
        gap: 1rem;
    }
    .left-section {
        width: 100%;
        justify-content: center;
    }
    .logo-section {
        position: static;
        transform: none;
        margin: 0.5rem 0;
    }
    .right-controls {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 768px) {
    .menu-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .card-control {
        flex-direction: column;
    }
    .quantity-control {
        width: 100%;
    }
    .recruit-btn {
        width: 100%;
    }
}